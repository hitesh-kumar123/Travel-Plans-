# =============================================
# PackGo Client - Environment Configuration
# =============================================

# ----- API Configuration -----
# Live Backend (Production on Render)
VITE_API_URL=https://travel-plans.onrender.com/api

# Local Backend (Development on port 5000)
# VITE_API_URL=http://localhost:5000/api

# ----- Google OAuth 2.0 -----
# Paste your Google OAuth 2.0 Client ID here from Google Cloud Console
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ----- Currency Conversion (Frankfurter) -----
VITE_FRANKFURTER_API_URL=https://api.frankfurter.dev/v1
